{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023"], "types": ["react", "node"], "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "baseUrl": ".", "paths": {"@shared/*": ["shared/*"], "@server/*": ["server/*"], "@client/*": ["client/*"], "@test/*": ["tests/*"]}
  },
  "include": ["**/*.ts", "**/*.tsx"], "exclude": ["node_modules", "dist", "docs/core-api", "proof"]
}
